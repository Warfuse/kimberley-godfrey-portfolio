{
  "name": "kimberley-godfrey-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HILO_REPORTS",
        "class_name": "HiloReports",
      },
    ],
  },
  "migrations": [
    {
      "tag": "hilo-reports-v1",
      "new_sqlite_classes": ["HiloReports"],
    },
  ],
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "DATA_VERSION": "2a6b9f700faf",
    "AI_ENABLED_UNTIL": "0",
  },
  "observability": {
    "enabled": false,
  },
  "routes": [
    {
      "pattern": "amaplan.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.amaplan.com",
      "custom_domain": true,
    },
  ],
}
